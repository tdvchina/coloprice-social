# Copy to .env.local (gitignored). In CI the same names come from GitHub Secrets / Variables.
# Never commit real values.

# Public base URL of the out/ folder (slides are fetched by Meta from here). Repo must be PUBLIC.
#   raw:   https://raw.githubusercontent.com/tdvchina/coloprice-social/main/out
#   pages: https://tdvchina.github.io/coloprice-social/out
SLIDES_BASE_URL=https://raw.githubusercontent.com/tdvchina/coloprice-social/main/out

# Instagram Graph API (System User token — never expires)
IG_USER_ID=
IG_ACCESS_TOKEN=
# GRAPH_API_VERSION=v23.0
# IG_GRAPH_HOST=graph.facebook.com     # graph.instagram.com if using "Instagram API with Instagram Login"

# Telegram (same bot/chat convention as Dream View; chat id may be a comma-separated list)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X (Twitter) — OAuth 1.0a user context of the @coloprice account (SETUP.md → «X (Twitter)»).
# The app must be "Read and write" BEFORE the access token is generated, or the token is read-only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Optional: handle for nicer post URLs in Telegram (x.com/<handle>/status/<id>), without @
X_HANDLE=coloprice

# Comma-separated client/deal names that must never appear in a post (secret; never echoed in logs)
CONTENT_DENYLIST=

# Optional: local Coloprice data folder for richer data hooks (capacity-watch)
# COLOPRICE_DATA_DIR=/Users/misscarol/Artem Claude/colocationindex/src/data
